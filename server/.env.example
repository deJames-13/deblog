# PostgreSQL / Supabase Database Connection String (Session Pooler with IPv4 support)
DB_CONNECTION="Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"

# PostgreSQL Schema (isolates deblog tables and migrations from other apps in Supabase)
DB_SCHEMA="deblog"

# Supabase Project JWT Secret (Found in Supabase Dashboard > Settings > API > JWT Settings)
JWT_SECRET="your-supabase-jwt-secret"

# CORS Allowed Origins (comma-separated list for Angular client)
CORS_ORIGINS="http://localhost:4200,http://localhost:3000,https://deblog.derickespinosa.site,https://*.vercel.app"

# Main Author Details (automatically seeded on startup with Role: Admin)
AUTHOR_USERNAME="dej"
AUTHOR_EMAIL="author@example.com"
AUTHOR_DISPLAYNAME="Derick Espinosa"
AUTHOR_AVATARURL="http://deblog.derickespinosa.site/assets/images/me.png"
AUTHOR_PASSWORD="your-secure-author-password"

# Frontend Base URL (for generating canonical post URLs)
APP_BASE_URL="http://localhost:4200"

# Swagger Documentation UI Toggle (optional, defaults to true)
ENABLE_SWAGGER=true
