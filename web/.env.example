# deblog Web Frontend Environment Configuration (.env)
# Values are loaded from .env into src/app/core/config/app-config.generated.ts via scripts/set-env.mjs.
# Do NOT commit secrets or service keys here.

# API Base URL (routed through proxy.conf.json to http://localhost:5065 during `ng serve`)
API_URL=/api

# Supabase Project URL
SUPABASE_URL=https://jtszesnaluflmaldqwme.supabase.co

# Supabase Public Anon Key (Found in Supabase Dashboard > Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Author / Admin Email (matched against Supabase Auth user)
AUTHOR_EMAIL=derickespinosa.espinosa@gmail.com

# Fallback to local mock cache if backend server is unreachable
USE_MOCK_FALLBACK=true
